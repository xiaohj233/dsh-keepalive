{
  "name": "dsh-keepalive",
  "version": "0.2.12",
  "description": "Opt-in detached watchdog for the DSH Web process with optional snapshot-checked repair and explicit patch restoration.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-keepalive-uninstall": "bin/uninstall.mjs"
  },
  "files": [
    "lib",
    "bin",
    "client.js",
    "watchdog.mjs",
    "restarter.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:llm": "node test/llm-config.test.mjs",
    "test:patches": "node test/installed-patches.test.mjs",
    "test:snapshot": "node test/snapshot-rollback.test.mjs",
    "test:uninstall": "node test/uninstall.test.mjs",
    "check:syntax": "node test/check-syntax.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaohj233/dsh-keepalive.git"
  },
  "homepage": "https://github.com/xiaohj233/dsh-keepalive#readme",
  "bugs": {
    "url": "https://github.com/xiaohj233/dsh-keepalive/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  }
}
